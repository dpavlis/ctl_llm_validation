  "facts_needing_runtime_or_added_reference": [
    "UTF-16 length semantics are now part of the explicit prompt convention. Root compiler/source verification can document this CTL runtime fact; no unresolved contract ambiguity remains."
  ],
  "findings": [
    {
      "id": "R64-01",
      "tests": [
        "T64",
        "T65"
      ],
      "severity": "verification_gap",
      "finding": "Reference directly indexes optional variant-map keys. Missing-key indexing semantics are not explicit in ctl2-basics.md; compilation cannot prove missing-key behavior.",
      "action": "Use containsKey guards for the optional root array, details, note and amount keys, or record a runtime probe for omitted keys and JSON null.",
      "evidence": "resources/ctl2-basics.md \u00a72.3 documents bracket access; \u00a711.5 documents containsKey(variant,variant). Neither explicitly guarantees absent variant-map keys return null.",
      "status": "resolved",
      "resolution": "Both Normalizer references guard all optional map keys with containsKey before bracket access; null details short-circuits nested access. No absent-key indexing assumption remains."
    },
    {
      "id": "R64-02",
      "tests": [
        "T68",
        "T69"
      ],
      "severity": "contract_error",
      "finding": "The no-range-restriction contract permits net amounts outside output metadata precision 18 / scale 2.",
      "counterexample": {
        "gross_amount": "9999999999999999.99",
        "discount_percent": "-100.00",
        "expected_net_amount": "19999999999999999.98"
      },
      "action": "State upstream numerical bounds that guarantee output representability while allowing negatives and pct >100, or enlarge output net_amount precision and verify intermediate arithmetic limits.",
      "evidence": "Clause3 allows negative percentages without clamping; input fields length18 scale2 permit the counterexample; output net_amount uses the same precision.",
      "status": "resolved",
      "resolution": "Both pricing prompts now guarantee gross in [-1000000,1000000] and pct in [-1000,1000]. Absolute computed net is at most 11000000, fitting precision18 scale2. Negative values and pct >100 remain supported without clamping."
    },
    {
      "id": "R64-03",
      "tests": [
        "T72",
        "T73"
      ],
      "severity": "rubric_gap",
      "finding": "Required item1 asks to read parameters and parse RUN_TS but does not explicitly check assignments to run_id, run_ts and audit_source. A program could calculate and discard those values while copying originals.",
      "action": "Require run_id=getParamValue(RUN_ID), run_ts=strict UTC parse of RUN_TS, audit_source=SOURCE_FILE, accepting equivalent parameter access.",
      "evidence": "Clause1 explicitly names the three target fields, whereas required item1 omits all three assignments and item7 checks originals only.",
      "status": "resolved",
      "resolution": "Both audit required item1 checks now explicitly assign run_id from RUN_ID, run_ts from strict UTC RUN_TS, and audit_source from SOURCE_FILE."
    },
    {
      "id": "R64-04",
      "tests": [
        "T70",
        "T71"
      ],
      "severity": "wording",
      "finding": "Required item5 says six constant/context fields, but clause5 has five such fields, plus two derived text references.",
      "action": "List tenant_cd, source_file_nm, source_row_no, currency_cd and batch_ref explicitly, together with the reference and trace mappings.",
      "status": "resolved",
      "resolution": "Both generator item5 checks enumerate tenant_cd, source_file_nm, source_row_no, currency_cd and batch_ref along with reference and trace."
    },
    {
      "id": "R64-05",
      "tests": [
        "T72",
        "T73"
      ],
      "severity": "clarification",
      "finding": "The phrase character length does not distinguish Unicode code points from CTL length(string) units; ASCII and delimiter framing are otherwise unambiguous.",
      "action": "Specify length(part) using CTL string-length semantics so supplementary Unicode characters are judged consistently.",
      "status": "resolved",
      "resolution": "Both audit prompts explicitly define framing length as CTL length(string), counting UTF-16 code units, and require the writer to use the same convention."
    }
  ],
