    <Node id="Decode0" type="REFORMAT" enabled="enabled" guiName="Decode0" guiX="275" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.freight_batch=$in.0.freight_batch;
$out.0.freight_loaded=$in.0.freight_loaded == null ? null : str2date($in.0.freight_loaded,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.freight_ledger=$in.0.freight_ledger == null ? null : str2decimal($in.0.freight_ledger);
$out.0.freight_unused=$in.0.freight_unused;
$out.0.freight_note=$in.0.freight_note;
$out.0.freight_row=$in.0.freight_row == null ? null : str2long($in.0.freight_row);
$out.0.shipment_ref=$in.0.shipment_ref;
$out.0.carrier_cd=$in.0.carrier_cd;
$out.0.service_cd=$in.0.service_cd;
$out.0.pickup_day=$in.0.pickup_day == null ? null : str2date($in.0.pickup_day,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.insured_value=$in.0.insured_value == null ? null : str2decimal($in.0.insured_value);
$out.0.destination_zone=$in.0.destination_zone;
return OK;}</attr>
    </Node>
    <Edge id="Read0" fromNode="Reader0:0" toNode="Decode0:0" metadata="RawIn0" guiRouter="Manhattan" inPort="Port 0 (in)" outPort="Port 0 (out)" />
    <Edge id="Decoded0" fromNode="Decode0:0" toNode="Test:0" metadata="In0" guiRouter="Manhattan" inPort="Port 0 (in)" outPort="Port 0 (out)" />
    <Node id="Test" type="REFORMAT" enabled="enabled" guiName="Test" guiX="500" guiY="200">
      <attr name="charset">UTF-8</attr>
      <attr name="transform">//#CTL2
function boolean eligible(RouteRule r,date d){return r!=null&amp;&amp;d&gt;=r.valid_from&amp;&amp;(r.valid_to==null||d&lt;=r.valid_to)&amp;&amp;(r.sla_days==null||r.sla_days&gt;=0);}
 function integer transform(){$out.0.*=$in.0.*;string a=upperCase(trim(nvl($in.0.carrier_cd,"")));string b=upperCase(trim(nvl($in.0.service_cd,"")));$out.0.reference_key=a+":"+b;$out.0.sla_days=5;$out.0.reference_miss=true;$out.0.reference_level="NONE";if(a!=""&amp;&amp;b!=""&amp;&amp;$in.0.pickup_day!=null){RouteRule r=lookup(ServiceRules).get(a,b);string level="EXACT";if(!eligible(r,$in.0.pickup_day)){r=lookup(ServiceRules).get(a,"*");level="CARRIER";}if(!eligible(r,$in.0.pickup_day)){r=lookup(ServiceRules).get("*","*");level="NETWORK";}if(eligible(r,$in.0.pickup_day)){$out.0.sla_days=nvl(r.sla_days,5);$out.0.reference_miss=false;$out.0.reference_level=level;}}return OK;}</attr>
    </Node>
    <Node id="Encode0" type="REFORMAT" enabled="enabled" guiName="Encode0" guiX="725" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.freight_batch=$in.0.freight_batch;
$out.0.freight_loaded=$in.0.freight_loaded == null ? null : date2str($in.0.freight_loaded,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.freight_ledger=$in.0.freight_ledger == null ? null : num2str($in.0.freight_ledger,"0.00","en.US");
$out.0.freight_unused=$in.0.freight_unused;
$out.0.freight_note=$in.0.freight_note;
$out.0.freight_row=$in.0.freight_row == null ? null : num2str($in.0.freight_row);
$out.0.shipment_ref=$in.0.shipment_ref;
$out.0.carrier_cd=$in.0.carrier_cd;
$out.0.service_cd=$in.0.service_cd;
$out.0.pickup_day=$in.0.pickup_day == null ? null : date2str($in.0.pickup_day,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.insured_value=$in.0.insured_value == null ? null : num2str($in.0.insured_value,"0.00","en.US");
$out.0.destination_zone=$in.0.destination_zone;
$out.0.sla_days=$in.0.sla_days == null ? null : num2str($in.0.sla_days);
$out.0.reference_miss=$in.0.reference_miss == null ? null : ($in.0.reference_miss ? "true" : "false");
$out.0.reference_level=$in.0.reference_level;
$out.0.reference_key=$in.0.reference_key;
return OK;}</attr>
    </Node>
