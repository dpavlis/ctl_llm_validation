decimal current_context_value;
boolean have_key;
string current_business_key;
boolean have_version;
long sk;
date from_at;
string region;
decimal fee;
function integer transform() {
 if(!have_key || current_business_key!=$in.0.business_ref) {have_key=true;current_business_key=$in.0.business_ref;have_version=!isnull($in.0.seed_sk);sk=$in.0.seed_sk;from_at=$in.0.seed_from;region=$in.0.seed_region;fee=$in.0.seed_fee;current_business_ref=$in.0.business_ref;current_tenant_cd=$in.0.tenant_cd;current_source_file=$in.0.source_file;current_source_row=$in.0.source_row;current_received_at=$in.0.received_at;current_currency_cd=$in.0.currency_cd;current_operator_note=$in.0.operator_note;current_market_cd=$in.0.market_cd;current_owner_team=$in.0.owner_team;current_trace_id=$in.0.trace_id;current_unused_archive_label=$in.0.unused_archive_label;current_context_value=$in.0.context_value;}
 boolean changed=$in.0.region_cd!=region || $in.0.service_fee!=fee;
 if(have_version &amp;&amp; !changed) return SKIP;
 boolean close=have_version;
 if(close) {$out.0.business_ref=current_business_ref;$out.0.tenant_cd=current_tenant_cd;$out.0.source_file=current_source_file;$out.0.source_row=current_source_row;$out.0.received_at=current_received_at;$out.0.currency_cd=current_currency_cd;$out.0.operator_note=current_operator_note;$out.0.market_cd=current_market_cd;$out.0.owner_team=current_owner_team;$out.0.trace_id=current_trace_id;$out.0.unused_archive_label=current_unused_archive_label;$out.0.context_value=current_context_value;$out.0.region_cd=region;$out.0.service_fee=fee;$out.0.version_sk=sk;$out.0.valid_from=from_at;$out.0.valid_to=$in.0.effective_at;$out.0.is_current=false;}
 long next_key=sequence(GeoKeys,long).next();
 $out.1.*=$in.0.*;$out.1.version_sk=next_key;$out.1.valid_from=$in.0.effective_at;$out.1.valid_to=null;$out.1.is_current=true;
 current_business_ref=$in.0.business_ref;current_tenant_cd=$in.0.tenant_cd;current_source_file=$in.0.source_file;current_source_row=$in.0.source_row;current_received_at=$in.0.received_at;current_currency_cd=$in.0.currency_cd;current_operator_note=$in.0.operator_note;current_market_cd=$in.0.market_cd;current_owner_team=$in.0.owner_team;current_trace_id=$in.0.trace_id;current_unused_archive_label=$in.0.unused_archive_label;current_context_value=$in.0.context_value;region=$in.0.region_cd;fee=$in.0.service_fee;sk=next_key;from_at=$in.0.effective_at;have_version=true;
 if(close) return ALL;return 1;
}</attr>
