    <Node id="Decode0" type="REFORMAT" enabled="enabled" guiName="Decode0" guiX="275" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.claim_batch=$in.0.claim_batch;
$out.0.claim_loaded=$in.0.claim_loaded == null ? null : str2date($in.0.claim_loaded,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.claim_ledger=$in.0.claim_ledger == null ? null : str2decimal($in.0.claim_ledger);
$out.0.claim_unused=$in.0.claim_unused;
$out.0.claim_note=$in.0.claim_note;
$out.0.claim_row=$in.0.claim_row == null ? null : str2long($in.0.claim_row);
$out.0.claim_ref=$in.0.claim_ref;
$out.0.provider_id=$in.0.provider_id;
$out.0.region_id=$in.0.region_id;
$out.0.loss_at=$in.0.loss_at == null ? null : str2date($in.0.loss_at,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.claim_amount=$in.0.claim_amount == null ? null : str2decimal($in.0.claim_amount);
$out.0.coverage_label=$in.0.coverage_label;
return OK;}</attr>
    </Node>
    <Edge id="Read0" fromNode="Reader0:0" toNode="Decode0:0" metadata="RawIn0" guiRouter="Manhattan" inPort="Port 0 (in)" outPort="Port 0 (out)" />
