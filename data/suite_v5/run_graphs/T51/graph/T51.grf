    <Node id="Test" type="REFORMAT" enabled="enabled" guiName="Test" guiX="500" guiY="200">
      <attr name="charset">UTF-8</attr>
      <attr name="transform">//#CTL2
function integer transform(){$out.0.*=$in.0.*;$out.0.selected_tariff="";$out.0.tariff_missing=true;$out.0.payout=0D;string a=upperCase(trim(nvl($in.0.provider_id,"")));string b=upperCase(trim(nvl($in.0.region_id,"")));boolean found=false;ClaimTariff best;if(a!=""&amp;&amp;b!=""&amp;&amp;$in.0.loss_at!=null){ClaimTariff r=lookup(ClaimTariffs).get(a,b);while(r!=null){boolean good=$in.0.loss_at&gt;=r.effective_from&amp;&amp;(r.effective_to==null||$in.0.loss_at&lt;=r.effective_to)&amp;&amp;r.payout_percent!=null&amp;&amp;r.payout_percent&gt;=0D&amp;&amp;r.payout_percent&lt;=100D;if(good){if(!found||r.effective_from&gt;best.effective_from||(r.effective_from==best.effective_from&amp;&amp;(r.admin_fee&lt;best.admin_fee||(r.admin_fee==best.admin_fee&amp;&amp;r.tariff_id&lt;best.tariff_id)))){best=r;found=true;}}r=lookup(ClaimTariffs).next();}}if(found){$out.0.selected_tariff=best.tariff_id;$out.0.tariff_missing=false;if($in.0.claim_amount!=null&amp;&amp;$in.0.claim_amount&gt;0D)$out.0.payout=round($in.0.claim_amount*best.payout_percent/100D,2);}return OK;}</attr>
    </Node>
    <Node id="Encode0" type="REFORMAT" enabled="enabled" guiName="Encode0" guiX="725" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.claim_batch=$in.0.claim_batch;
$out.0.claim_loaded=$in.0.claim_loaded == null ? null : date2str($in.0.claim_loaded,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.claim_ledger=$in.0.claim_ledger == null ? null : num2str($in.0.claim_ledger,"0.00","en.US");
$out.0.claim_unused=$in.0.claim_unused;
$out.0.claim_note=$in.0.claim_note;
$out.0.claim_row=$in.0.claim_row == null ? null : num2str($in.0.claim_row);
$out.0.claim_ref=$in.0.claim_ref;
$out.0.provider_id=$in.0.provider_id;
$out.0.region_id=$in.0.region_id;
$out.0.loss_at=$in.0.loss_at == null ? null : date2str($in.0.loss_at,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.claim_amount=$in.0.claim_amount == null ? null : num2str($in.0.claim_amount,"0.00","en.US");
$out.0.coverage_label=$in.0.coverage_label;
$out.0.selected_tariff=$in.0.selected_tariff;
$out.0.tariff_missing=$in.0.tariff_missing == null ? null : ($in.0.tariff_missing ? "true" : "false");
$out.0.payout=$in.0.payout == null ? null : num2str($in.0.payout,"0.00","en.US");
return OK;}</attr>
