    <Node id="Decode0" type="REFORMAT" enabled="enabled" guiName="Decode0" guiX="275" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.lab_batch=$in.0.lab_batch;
$out.0.lab_loaded=$in.0.lab_loaded == null ? null : str2date($in.0.lab_loaded,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.lab_ledger=$in.0.lab_ledger == null ? null : str2decimal($in.0.lab_ledger);
$out.0.lab_unused=$in.0.lab_unused;
$out.0.lab_note=$in.0.lab_note;
$out.0.lab_row=$in.0.lab_row == null ? null : str2long($in.0.lab_row);
$out.0.sample_id=$in.0.sample_id;
$out.0.facility_txt=$in.0.facility_txt;
$out.0.assay_txt=$in.0.assay_txt;
$out.0.result_txt=$in.0.result_txt;
$out.0.sampled_at=$in.0.sampled_at == null ? null : str2date($in.0.sampled_at,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.billing_amount=$in.0.billing_amount == null ? null : str2decimal($in.0.billing_amount);
return OK;}</attr>
    </Node>
    <Edge id="Read0" fromNode="Reader0:0" toNode="Decode0:0" metadata="RawIn0" guiRouter="Manhattan" inPort="Port 0 (in)" outPort="Port 0 (out)" />
    <Edge id="Decoded0" fromNode="Decode0:0" toNode="Test:0" metadata="In0" guiRouter="Manhattan" inPort="Port 0 (in)" outPort="Port 0 (out)" />
    <Node id="Test" type="REFORMAT" enabled="enabled" guiName="Test" guiX="500" guiY="200">
      <attr name="charset">UTF-8</attr>
      <attr name="transform">//#CTL2
function integer transform(){string a=upperCase(trim(nvl($in.0.facility_txt,"")));string b=upperCase(trim(nvl($in.0.assay_txt,"")));string v=trim(nvl($in.0.result_txt,""));string[] e=[];if(a=="")append(e,"FACILITY");if(!(b ~= "[A-Z][A-Z0-9]{1,5}"))append(e,"ASSAY");if(!(v ~= "-?[0-9]{1,6}(\\.[0-9]{1,3})?"))append(e,"VALUE");decimal factor=0D;string source="";if(length(e)==0){FacilityFactor f=lookup(FacilityFactors).get(a,b);if(f!=null&amp;&amp;f.enabled==false)append(e,"BLOCKED");else if(f!=null&amp;&amp;f.enabled==true&amp;&amp;f.factor!=null&amp;&amp;f.factor&gt;0D&amp;&amp;f.factor&lt;=1000000D){factor=f.factor;source="FACILITY";}else{AssayDefault g=lookup(AssayDefaults).get(b);if(g!=null&amp;&amp;g.factor!=null&amp;&amp;g.factor&gt;0D&amp;&amp;g.factor&lt;=1000000D){factor=g.factor;source="DEFAULT";}else append(e,"NO_FACTOR");}}if(length(e)&gt;0){$out.1.*=$in.0.*;$out.1.correction_reason=join(";",e);return 1;}$out.0.*=$in.0.*;$out.0.factor_used=factor;$out.0.factor_source=source;$out.0.calibrated_result=round(str2decimal(v)*factor,2);return 0;}</attr>
    </Node>
    <Node id="Encode0" type="REFORMAT" enabled="enabled" guiName="Encode0" guiX="725" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.lab_batch=$in.0.lab_batch;
$out.0.lab_loaded=$in.0.lab_loaded == null ? null : date2str($in.0.lab_loaded,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.lab_ledger=$in.0.lab_ledger == null ? null : num2str($in.0.lab_ledger,"0.00","en.US");
$out.0.lab_unused=$in.0.lab_unused;
$out.0.lab_note=$in.0.lab_note;
$out.0.lab_row=$in.0.lab_row == null ? null : num2str($in.0.lab_row);
$out.0.sample_id=$in.0.sample_id;
$out.0.facility_txt=$in.0.facility_txt;
$out.0.assay_txt=$in.0.assay_txt;
$out.0.result_txt=$in.0.result_txt;
$out.0.sampled_at=$in.0.sampled_at == null ? null : date2str($in.0.sampled_at,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.billing_amount=$in.0.billing_amount == null ? null : num2str($in.0.billing_amount,"0.00","en.US");
$out.0.calibrated_result=$in.0.calibrated_result == null ? null : num2str($in.0.calibrated_result,"0.00","en.US");
$out.0.factor_used=$in.0.factor_used == null ? null : num2str($in.0.factor_used,"0.00","en.US");
$out.0.factor_source=$in.0.factor_source;
return OK;}</attr>
    </Node>
