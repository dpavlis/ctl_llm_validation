$out.0.source_row_no=$in.0.source_row_no == null ? null : str2long($in.0.source_row_no);
$out.0.owner_team_cd=$in.0.owner_team_cd;
$out.0.market_cd=$in.0.market_cd;
$out.0.currency_cd=$in.0.currency_cd;
$out.0.batch_ref=$in.0.batch_ref;
$out.0.operator_note=$in.0.operator_note;
$out.0.external_trace_id=$in.0.external_trace_id;
$out.0.unused_archive_label=$in.0.unused_archive_label;
$out.0.group_key=$in.0.group_key;
$out.0.occurred_at=$in.0.occurred_at == null ? null : str2date($in.0.occurred_at,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.net_amount=$in.0.net_amount == null ? null : str2decimal($in.0.net_amount);
$out.0.status_cd=$in.0.status_cd;
$out.0.billable=$in.0.billable == null ? null : str2bool($in.0.billable);
