      <attr name="groupKeyFields">group_key</attr>
      <attr name="groupAccumulatorMetadataId">Accumulator</attr>
      <attr name="transform">//#CTL2
string first_claim_ref_no;
string first_tenant_cd;
string first_source_file_nm;
date first_received_at;
long first_source_row_no;
string first_owner_team_cd;
string first_market_cd;
string first_currency_cd;
string first_batch_ref;
string first_operator_note;
string first_external_trace_id;
string first_unused_archive_label;
function void initGroup(ReportAcc acc) {first_claim_ref_no=$in.0.claim_ref_no;first_tenant_cd=$in.0.tenant_cd;first_source_file_nm=$in.0.source_file_nm;first_received_at=$in.0.received_at;first_source_row_no=$in.0.source_row_no;first_owner_team_cd=$in.0.owner_team_cd;first_market_cd=$in.0.market_cd;first_currency_cd=$in.0.currency_cd;first_batch_ref=$in.0.batch_ref;first_operator_note=$in.0.operator_note;first_external_trace_id=$in.0.external_trace_id;first_unused_archive_label=$in.0.unused_archive_label;acc.n=0;acc.late=0;acc.eligible=0;acc.paid=0D;acc.pending=0D;acc.eligible_total=0D;acc.bad_amounts=0;acc.reopened=0;acc.previous_seen=false;acc.previous_status=null;}
function boolean updateGroup(ReportAcc acc) {
 acc.n++;
 if(acc.previous_seen &amp;&amp; acc.previous_status=="PAID" &amp;&amp; $in.0.status_cd=="PENDING") acc.reopened++;
 acc.previous_seen=true;acc.previous_status=$in.0.status_cd;
 if(!isnull($in.0.delay_days) &amp;&amp; $in.0.delay_days&gt;2 &amp;&amp; !$in.0.late_waived) acc.late++;
 decimal amount=$in.0.net_amount;boolean valid=true;
 if(!isnull($in.0.amount_override_txt)) {string txt=trim($in.0.amount_override_txt);if(!(txt ~= "-?[0-9]{1,10}(\\.[0-9]{1,2})?")) {acc.bad_amounts++;valid=false;}else amount=str2decimal(txt);}
 if(valid &amp;&amp; !isnull(amount)) {if($in.0.status_cd=="PAID") acc.paid+=amount;if($in.0.status_cd=="PENDING") acc.pending+=amount;if($in.0.billable) {acc.eligible++;acc.eligible_total+=amount;}}
 return false;
}
function integer updateTransform(integer counter,ReportAcc acc) {return SKIP;}
function boolean finishGroup(ReportAcc acc) {return true;}
function integer transform(integer counter,ReportAcc acc) {if(counter&gt;0) return SKIP;$out.0.claim_ref_no=first_claim_ref_no;$out.0.tenant_cd=first_tenant_cd;$out.0.source_file_nm=first_source_file_nm;$out.0.received_at=first_received_at;$out.0.source_row_no=first_source_row_no;$out.0.owner_team_cd=first_owner_team_cd;$out.0.market_cd=first_market_cd;$out.0.currency_cd=first_currency_cd;$out.0.batch_ref=first_batch_ref;$out.0.operator_note=first_operator_note;$out.0.external_trace_id=first_external_trace_id;$out.0.unused_archive_label=first_unused_archive_label;$out.0.group_key=$in.0.group_key;$out.0.period_label=date2str($in.0.occurred_at,"yyyy-MM","en.US","UTC");$out.0.rows_seen=acc.n;$out.0.paid_total=acc.paid;$out.0.pending_total=acc.pending;$out.0.billable_average=acc.eligible==0 ? null : round(acc.eligible_total/acc.eligible,2);$out.0.late_percent=round(100D*acc.late/acc.n,2);$out.0.bad_amount_rows=acc.bad_amounts;$out.0.reopened_rows=acc.reopened;return OK;}</attr>
    </Node>
