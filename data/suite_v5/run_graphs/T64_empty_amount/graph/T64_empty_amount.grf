$out.0.basket_unused_archive=$in.0.basket_unused_archive;
$out.0.payload_json=$in.0.payload_json;
$out.0.parent_value=$in.0.parent_value == null ? null : str2decimal($in.0.parent_value);
$out.0.business_dt=$in.0.business_dt == null ? null : str2date($in.0.business_dt,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
return OK;}</attr>
