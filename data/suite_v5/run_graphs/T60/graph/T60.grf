    <Node id="Test" type="NORMALIZER" enabled="enabled" guiName="Test" guiX="500" guiY="200">
      <attr name="charset">UTF-8</attr>
      <attr name="normalize">//#CTL2
integer n;
boolean exists;
boolean cancel;
boolean changed;
boolean bad;
decimal parsed_rate;
long new_key;
function integer count() {
 n=0;exists=!isnull($in.0.previous_sk);cancel=$in.0.request_kind=="CANCEL";changed=false;bad=false;parsed_rate=null;new_key=null;
 if(cancel) {n=exists ? 2 : 1;return n;}
 string text=isnull($in.0.new_rate_txt) ? "" : trim($in.0.new_rate_txt);
 if(text!="") {if(!(text ~= "[0-9]{1,8}(\\.[0-9]{1,2})?")) {bad=true;return 1;}parsed_rate=str2decimal(text);}
 changed=!exists || parsed_rate!=$in.0.previous_rate;
 if(!changed) return $in.0.audit_requested ? 1 : 0;
 new_key=sequence(PriceKeys,long).next();n=(exists ? 2 : 1)+($in.0.audit_requested ? 1 : 0);return n;
}
function integer transform(integer idx) {
 $out.0.*=$in.0.*;$out.0.*=$in.0.*;
 $out.0.audit_note="";$out.0.audit_note="";
 if(bad) {$out.0.version_sk=null;$out.0.valid_from=null;$out.0.valid_to=null;$out.0.is_current=null;$out.0.rate=null;$out.0.record_kind="ERROR";$out.0.audit_note="BAD_RATE";return OK;}
 if(cancel || !changed) {
  boolean closing=cancel &amp;&amp; exists &amp;&amp; idx==0;
  if(closing) {$out.0.version_sk=$in.0.previous_sk;$out.0.valid_from=$in.0.previous_from;$out.0.valid_to=$in.0.event_at;$out.0.is_current=false;$out.0.rate=$in.0.previous_rate;$out.0.record_kind="CLOSE";return 0;}
  $out.0.version_sk=$in.0.previous_sk;$out.0.valid_from=exists ? $in.0.previous_from : null;$out.0.valid_to=(cancel &amp;&amp; exists) ? $in.0.event_at : null;$out.0.is_current=exists ? !cancel : null;$out.0.rate=exists ? $in.0.previous_rate : null;$out.0.record_kind=cancel ? "CANCELLED" : "UNCHANGED";return OK;
 }
 if(exists &amp;&amp; idx==0) {$out.0.version_sk=$in.0.previous_sk;$out.0.valid_from=$in.0.previous_from;$out.0.valid_to=$in.0.event_at;$out.0.is_current=false;$out.0.rate=$in.0.previous_rate;$out.0.record_kind="CLOSE";return 0;}
 integer open_idx=exists ? 1 : 0;
 if(idx==open_idx) {$out.0.version_sk=new_key;$out.0.valid_from=$in.0.event_at;$out.0.valid_to=null;$out.0.is_current=true;$out.0.rate=parsed_rate;$out.0.record_kind="OPEN";return 0;}
 $out.0.version_sk=new_key;$out.0.valid_from=$in.0.event_at;$out.0.valid_to=null;$out.0.is_current=true;$out.0.rate=parsed_rate;$out.0.record_kind="REPRICED";return OK;
}
function void clean() {n=0;parsed_rate=null;new_key=null;}</attr>
    </Node>
    <Node id="Encode0" type="REFORMAT" enabled="enabled" guiName="Encode0" guiX="725" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.business_ref=$in.0.business_ref;
$out.0.tenant_cd=$in.0.tenant_cd;
$out.0.source_file=$in.0.source_file;
$out.0.source_row=$in.0.source_row == null ? null : num2str($in.0.source_row);
$out.0.received_at=$in.0.received_at == null ? null : date2str($in.0.received_at,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.currency_cd=$in.0.currency_cd;
$out.0.operator_note=$in.0.operator_note;
$out.0.market_cd=$in.0.market_cd;
$out.0.owner_team=$in.0.owner_team;
$out.0.trace_id=$in.0.trace_id;
$out.0.unused_archive_label=$in.0.unused_archive_label;
$out.0.context_value=$in.0.context_value == null ? null : num2str($in.0.context_value,"0.00","en.US");
$out.0.version_sk=$in.0.version_sk == null ? null : num2str($in.0.version_sk);
$out.0.valid_from=$in.0.valid_from == null ? null : date2str($in.0.valid_from,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.valid_to=$in.0.valid_to == null ? null : date2str($in.0.valid_to,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.is_current=$in.0.is_current == null ? null : ($in.0.is_current ? "true" : "false");
$out.0.rate=$in.0.rate == null ? null : num2str($in.0.rate,"0.00","en.US");
$out.0.record_kind=$in.0.record_kind;
$out.0.audit_note=$in.0.audit_note;
return OK;}</attr>
