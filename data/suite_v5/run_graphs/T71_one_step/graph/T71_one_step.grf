  <Phase number="0">
    <Node id="Test" type="DATA_GENERATOR" enabled="enabled" guiName="Test" guiX="500" guiY="200">
      <attr name="recordsNumber">${STEPS}</attr>
      <attr name="generate">//#CTL2
integer step=0;decimal level=5D;decimal spillTotal=0D;
// recordsNumber owns termination and does not call generate for zero steps.
function integer generate(){
 step++;$out.0.step_no=step;$out.0.prior_level=level;
 integer cycle=(step-1)%3;$out.0.inflow=cycle==0 ? 7D : cycle==1 ? 0D : 4D;
 if(step==4)$out.0.inflow=10D;
 $out.0.withdrawal=step==4 ? 0D : step%2==1 ? 3D : 8D;
 decimal raw=level+$out.0.inflow-$out.0.withdrawal;
 level=raw&lt;0D ? 0D : raw&gt;10D ? 10D : raw;
 $out.0.stored_level=level;$out.0.spill_amount=raw&gt;10D ? raw-10D : 0D;
 spillTotal=spillTotal+$out.0.spill_amount;$out.0.total_spill=spillTotal;
 $out.0.level_band=level==0D ? "EMPTY" : level==10D ? "FULL" : "PARTIAL";
 $out.0.simulation_day=dateAdd(createDate(2026,2,1,"UTC"),step-1,day);$out.0.tank_received=$out.0.simulation_day;
 $out.0.tank_key="SIM-"+num2str(step);$out.0.tank_trace="STEP-"+num2str(step);$out.0.tank_row=step;
 $out.0.tank_tenant="LAB";$out.0.tank_file="reservoir";$out.0.tank_currency="UNIT";$out.0.tank_batch="SIM";
 $out.0.tank_team=null;$out.0.tank_market=null;$out.0.tank_note=null;$out.0.tank_unused_archive=null;return OK;
}
</attr>
    </Node>
    <Node id="Encode0" type="REFORMAT" enabled="enabled" guiName="Encode0" guiX="725" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.tank_key=$in.0.tank_key;
$out.0.tank_tenant=$in.0.tank_tenant;
$out.0.tank_file=$in.0.tank_file;
$out.0.tank_row=$in.0.tank_row == null ? null : num2str($in.0.tank_row);
$out.0.tank_received=$in.0.tank_received == null ? null : date2str($in.0.tank_received,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.tank_team=$in.0.tank_team;
$out.0.tank_market=$in.0.tank_market;
$out.0.tank_currency=$in.0.tank_currency;
$out.0.tank_batch=$in.0.tank_batch;
$out.0.tank_note=$in.0.tank_note;
$out.0.tank_trace=$in.0.tank_trace;
$out.0.tank_unused_archive=$in.0.tank_unused_archive;
$out.0.step_no=$in.0.step_no == null ? null : num2str($in.0.step_no);
$out.0.prior_level=$in.0.prior_level == null ? null : num2str($in.0.prior_level,"0.00","en.US");
$out.0.inflow=$in.0.inflow == null ? null : num2str($in.0.inflow,"0.00","en.US");
$out.0.withdrawal=$in.0.withdrawal == null ? null : num2str($in.0.withdrawal,"0.00","en.US");
$out.0.stored_level=$in.0.stored_level == null ? null : num2str($in.0.stored_level,"0.00","en.US");
$out.0.spill_amount=$in.0.spill_amount == null ? null : num2str($in.0.spill_amount,"0.00","en.US");
$out.0.total_spill=$in.0.total_spill == null ? null : num2str($in.0.total_spill,"0.00","en.US");
$out.0.simulation_day=$in.0.simulation_day == null ? null : date2str($in.0.simulation_day,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.level_band=$in.0.level_band;
return OK;}</attr>
