$out.0.policy_contract_note=$in.0.policy_contract_note;
$out.0.policy_renewal_hint=$in.0.policy_renewal_hint;
$out.0.policy_number=$in.0.policy_number;
$out.0.mode_cd=$in.0.mode_cd;
$out.0.migration_warning=$in.0.migration_warning;
return OK;}</attr>
