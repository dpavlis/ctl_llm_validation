      <attr name="transform">//#CTL2
function integer transform(){
$out.0.policy_batch=$in.0.policy_batch;
$out.0.policy_loaded=$in.0.policy_loaded == null ? null : str2date($in.0.policy_loaded,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.policy_ledger=$in.0.policy_ledger == null ? null : str2decimal($in.0.policy_ledger);
$out.0.policy_unused=$in.0.policy_unused;
$out.0.policy_note=$in.0.policy_note;
$out.0.policy_row=$in.0.policy_row == null ? null : str2long($in.0.policy_row);
$out.0.legacy_policy_no=$in.0.legacy_policy_no;
$out.0.billing_mode=$in.0.billing_mode;
$out.0.suspended=$in.0.suspended == null ? null : str2bool($in.0.suspended);
$out.0.manual_override=$in.0.manual_override;
$out.0.display_nm=$in.0.display_nm;
$out.0.email_txt=$in.0.email_txt;
$out.0.credit_balance=$in.0.credit_balance == null ? null : str2decimal($in.0.credit_balance);
$out.0.retired_at=$in.0.retired_at == null ? null : str2date($in.0.retired_at,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.policy_agent_ref=$in.0.policy_agent_ref;
$out.0.policy_language_cd=$in.0.policy_language_cd;
