    <Node id="Test" type="REFORMAT" enabled="enabled" guiName="Test" guiX="500" guiY="200">
      <attr name="charset">UTF-8</attr>
      <attr name="transform">//#CTL2
map[string,string] modes={"M"-&gt;"MONTHLY","A"-&gt;"ANNUAL"};function integer transform(){$out.0.*=$in.0.*;string id=trim($in.0.legacy_policy_no);$out.0.policy_number=id==""?"UNASSIGNED":id;string src=upperCase(trim(nvl($in.0.billing_mode,"")));string mode=containsKey(modes,src)?modes[src]:"MANUAL";string[] warningsList=[];if(src!=""&amp;&amp;!containsKey(modes,src))append(warningsList,"UNKNOWN_MODE");if($in.0.manual_override!=null){string o=upperCase(trim($in.0.manual_override));if(o=="")mode="MANUAL";else if(containsKey(modes,o))mode=modes[o];else append(warningsList,"BAD_OVERRIDE");}if(nvl($in.0.suspended,false))mode="HOLD";$out.0.mode_cd=mode;$out.0.migration_warning=join(";",warningsList);string n=trim(nvl($in.0.display_nm,""));$out.0.display_nm=n==""?"Unnamed":n;$out.0.email_txt=$in.0.email_txt==null?null:lowerCase(trim($in.0.email_txt));return OK;}</attr>
    </Node>
    <Node id="Encode0" type="REFORMAT" enabled="enabled" guiName="Encode0" guiX="725" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.policy_batch=$in.0.policy_batch;
$out.0.policy_loaded=$in.0.policy_loaded == null ? null : date2str($in.0.policy_loaded,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.policy_ledger=$in.0.policy_ledger == null ? null : num2str($in.0.policy_ledger,"0.00","en.US");
$out.0.policy_unused=$in.0.policy_unused;
$out.0.policy_note=$in.0.policy_note;
$out.0.policy_row=$in.0.policy_row == null ? null : num2str($in.0.policy_row);
$out.0.suspended=$in.0.suspended == null ? null : ($in.0.suspended ? "true" : "false");
$out.0.display_nm=$in.0.display_nm;
$out.0.email_txt=$in.0.email_txt;
$out.0.credit_balance=$in.0.credit_balance == null ? null : num2str($in.0.credit_balance,"0.00","en.US");
$out.0.retired_at=$in.0.retired_at == null ? null : date2str($in.0.retired_at,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.policy_agent_ref=$in.0.policy_agent_ref;
$out.0.policy_language_cd=$in.0.policy_language_cd;
$out.0.policy_tax_ref=$in.0.policy_tax_ref;
$out.0.policy_delivery_addr=$in.0.policy_delivery_addr;
$out.0.policy_country_cd=$in.0.policy_country_cd;
$out.0.policy_currency_label=$in.0.policy_currency_label;
$out.0.policy_product_family=$in.0.policy_product_family;
$out.0.policy_rider_txt=$in.0.policy_rider_txt;
