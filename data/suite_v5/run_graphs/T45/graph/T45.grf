    <Node id="Decode0" type="REFORMAT" enabled="enabled" guiName="Decode0" guiX="275" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.clinic_batch=$in.0.clinic_batch;
$out.0.clinic_loaded=$in.0.clinic_loaded == null ? null : str2date($in.0.clinic_loaded,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.clinic_ledger=$in.0.clinic_ledger == null ? null : str2decimal($in.0.clinic_ledger);
$out.0.clinic_unused=$in.0.clinic_unused;
$out.0.clinic_note=$in.0.clinic_note;
$out.0.clinic_row=$in.0.clinic_row == null ? null : str2long($in.0.clinic_row);
$out.0.enrollment_id=$in.0.enrollment_id;
$out.0.age_txt=$in.0.age_txt;
$out.0.guardian_id=$in.0.guardian_id;
$out.0.consent_txt=$in.0.consent_txt;
$out.0.visit_day_txt=$in.0.visit_day_txt;
$out.0.program_txt=$in.0.program_txt;
$out.0.clinic_patient_name=$in.0.clinic_patient_name;
$out.0.clinic_insurer_ref=$in.0.clinic_insurer_ref;
$out.0.clinic_practice_ref=$in.0.clinic_practice_ref;
$out.0.clinic_contact_phone=$in.0.clinic_contact_phone;
$out.0.clinic_residence_city=$in.0.clinic_residence_city;
$out.0.clinic_postcode=$in.0.clinic_postcode;
$out.0.clinic_language_pref=$in.0.clinic_language_pref;
