    <Node id="Test" type="REFORMAT" enabled="enabled" guiName="Test" guiX="500" guiY="200">
      <attr name="charset">UTF-8</attr>
      <attr name="transform">//#CTL2
function integer transform(){string[] e=[];string a=trim(nvl($in.0.age_txt,""));boolean ageOK=a ~= "[0-9]{1,3}";integer age=0;if(ageOK){age=str2integer(a);ageOK=age&lt;=120;}if(!ageOK)append(e,"AGE");if(ageOK&amp;&amp;age&lt;18&amp;&amp;trim(nvl($in.0.guardian_id,""))=="")append(e,"GUARDIAN");if(upperCase(trim(nvl($in.0.consent_txt,"")))!="Y")append(e,"CONSENT");string d=nvl($in.0.visit_day_txt,"");boolean dayOK=d ~= "[0-9]{4}-[0-9]{2}-[0-9]{2}";date appointmentDate=1970-01-01;if(dayOK){dayOK=isDate(d,"yyyy-MM-dd","en.US","UTC",true);if(dayOK){appointmentDate=str2date(d,"yyyy-MM-dd","en.US","UTC",true);dayOK=appointmentDate&gt;=createDate(2026,4,1,"UTC")&amp;&amp;appointmentDate&lt;=createDate(2026,4,30,"UTC");}}if(!dayOK)append(e,"VISIT");string p=upperCase(trim(nvl($in.0.program_txt,"")));if(!(p=="WELL"||(p=="SENIOR"&amp;&amp;ageOK&amp;&amp;age&gt;=65)))append(e,"PROGRAM");if(length(e)&gt;0){$out.1.*=$in.0.*;$out.1.correction_codes=join(",",e);return 1;}$out.0.*=$in.0.*;$out.0.patient_age=age;$out.0.appointment_day=appointmentDate;$out.0.normalized_program=p;return 0;}</attr>
    </Node>
