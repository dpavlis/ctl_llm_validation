    <Node id="Decode0" type="REFORMAT" enabled="enabled" guiName="Decode0" guiX="275" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.cold_key=$in.0.cold_key;
$out.0.cold_tenant=$in.0.cold_tenant;
$out.0.cold_file=$in.0.cold_file;
$out.0.cold_row=$in.0.cold_row == null ? null : str2long($in.0.cold_row);
$out.0.cold_received=$in.0.cold_received == null ? null : str2date($in.0.cold_received,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.cold_team=$in.0.cold_team;
$out.0.cold_market=$in.0.cold_market;
$out.0.cold_currency=$in.0.cold_currency;
$out.0.cold_batch=$in.0.cold_batch;
$out.0.cold_note=$in.0.cold_note;
$out.0.cold_trace=$in.0.cold_trace;
$out.0.cold_unused_archive=$in.0.cold_unused_archive;
$out.0.trip_id=$in.0.trip_id;
$out.0.sample_no=$in.0.sample_no == null ? null : str2integer($in.0.sample_no);
$out.0.sensor_off=$in.0.sensor_off == null ? null : str2bool($in.0.sensor_off);
$out.0.temperature_txt=$in.0.temperature_txt;
$out.0.shipment_value=$in.0.shipment_value == null ? null : str2decimal($in.0.shipment_value);
$out.0.sample_time=$in.0.sample_time == null ? null : str2date($in.0.sample_time,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
return OK;}</attr>
    </Node>
    <Edge id="Read0" fromNode="Reader0:0" toNode="Decode0:0" metadata="RawIn0" guiRouter="Manhattan" inPort="Port 0 (in)" outPort="Port 0 (out)" />
