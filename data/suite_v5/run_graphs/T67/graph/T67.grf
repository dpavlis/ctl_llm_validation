    <Node id="Test" type="PARTITION" enabled="enabled" guiName="Test" guiX="500" guiY="200">
      <attr name="charset">UTF-8</attr>
      <attr name="partitionSource">//#CTL2
string trip;boolean groupSeen=false;boolean validSeen=false;integer prevNo;decimal prevTemp;
function integer getOutputPort(){
 if(!groupSeen || trip!=$in.0.trip_id){trip=$in.0.trip_id;groupSeen=true;validSeen=false;}
 if($in.0.sensor_off)return 0;
 string raw=trim(nvl($in.0.temperature_txt,""));
 if(!(raw ~= "-?[0-9]{1,2}(\\.[0-9])?"))return 1;
 decimal t=str2decimal(raw);if(t &lt; -50D || t &gt; 50D)return 1;
 integer port=4;
 if(validSeen &amp;&amp; $in.0.sample_no-prevNo&gt;1)port=2;
 else if(t&gt;8D || t &lt; -20D || (validSeen &amp;&amp; abs(t-prevTemp)&gt;5D))port=3;
 prevNo=$in.0.sample_no;prevTemp=t;validSeen=true;return port;
}
function integer getOutputPortOnError(string message,string stackTrace){printLog(error,message);return 1;}
</attr>
    </Node>
    <Node id="Encode0" type="REFORMAT" enabled="enabled" guiName="Encode0" guiX="725" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.cold_key=$in.0.cold_key;
$out.0.cold_tenant=$in.0.cold_tenant;
$out.0.cold_file=$in.0.cold_file;
$out.0.cold_row=$in.0.cold_row == null ? null : num2str($in.0.cold_row);
$out.0.cold_received=$in.0.cold_received == null ? null : date2str($in.0.cold_received,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.cold_team=$in.0.cold_team;
$out.0.cold_market=$in.0.cold_market;
$out.0.cold_currency=$in.0.cold_currency;
$out.0.cold_batch=$in.0.cold_batch;
$out.0.cold_note=$in.0.cold_note;
$out.0.cold_trace=$in.0.cold_trace;
$out.0.cold_unused_archive=$in.0.cold_unused_archive;
$out.0.trip_id=$in.0.trip_id;
$out.0.sample_no=$in.0.sample_no == null ? null : num2str($in.0.sample_no);
$out.0.sensor_off=$in.0.sensor_off == null ? null : ($in.0.sensor_off ? "true" : "false");
$out.0.temperature_txt=$in.0.temperature_txt;
$out.0.shipment_value=$in.0.shipment_value == null ? null : num2str($in.0.shipment_value,"0.00","en.US");
$out.0.sample_time=$in.0.sample_time == null ? null : date2str($in.0.sample_time,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
return OK;}</attr>
