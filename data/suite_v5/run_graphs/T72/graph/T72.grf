    <Node id="Decode0" type="REFORMAT" enabled="enabled" guiName="Decode0" guiX="275" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.receipt_key=$in.0.receipt_key;
$out.0.receipt_tenant=$in.0.receipt_tenant;
$out.0.receipt_file=$in.0.receipt_file;
$out.0.receipt_row=$in.0.receipt_row == null ? null : str2long($in.0.receipt_row);
$out.0.receipt_received=$in.0.receipt_received == null ? null : str2date($in.0.receipt_received,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.receipt_team=$in.0.receipt_team;
$out.0.receipt_market=$in.0.receipt_market;
$out.0.receipt_currency=$in.0.receipt_currency;
$out.0.receipt_batch=$in.0.receipt_batch;
$out.0.receipt_note=$in.0.receipt_note;
$out.0.receipt_trace=$in.0.receipt_trace;
$out.0.receipt_unused_archive=$in.0.receipt_unused_archive;
$out.0.merchant_cd=$in.0.merchant_cd;
$out.0.transaction_ref=$in.0.transaction_ref;
$out.0.posted_amount=$in.0.posted_amount == null ? null : str2decimal($in.0.posted_amount);
$out.0.posting_dt=$in.0.posting_dt == null ? null : str2date($in.0.posting_dt,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
return OK;}</attr>
    </Node>
    <Edge id="Read0" fromNode="Reader0:0" toNode="Decode0:0" metadata="RawIn0" guiRouter="Manhattan" inPort="Port 0 (in)" outPort="Port 0 (out)" />
