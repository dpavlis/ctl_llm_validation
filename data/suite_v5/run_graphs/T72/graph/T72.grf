    <Node id="Test" type="REFORMAT" enabled="enabled" guiName="Test" guiX="500" guiY="200">
      <attr name="charset">UTF-8</attr>
      <attr name="transform">//#CTL2
function string frame(string v){return num2str(length(v))+":"+v;}
function string mark(string v){return isnull(v)?"N":"V"+v;}
function integer transform(){
 $out.0.*=$in.0.*;$out.0.run_id=getParamValue("AUDIT_RUN_ID");$out.0.audit_source=getParamValue("SOURCE_FILE");
 $out.0.run_ts=str2date(getParamValue("RUN_TS"),"yyyy-MM-dd HH:mm:ss","en.US","UTC",true);
 string a=mark($in.0.merchant_cd);string b=mark($in.0.transaction_ref);
 string c=isnull($in.0.posted_amount)?"N":"V"+num2str(round($in.0.posted_amount,2),"0.00","en.US");
 string d=isnull($in.0.posting_dt)?"N":"V"+date2str($in.0.posting_dt,"yyyy-MM-dd HH:mm:ss","en.US","UTC");
 $out.0.record_digest=lowerCase(sha256HexString(frame(a)+frame(b)+frame(c)+frame(d)));
 $out.0.audit_seq=sequence(AuditRows,long).next();return OK;
}
</attr>
    </Node>
    <Node id="Encode0" type="REFORMAT" enabled="enabled" guiName="Encode0" guiX="725" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.receipt_key=$in.0.receipt_key;
$out.0.receipt_tenant=$in.0.receipt_tenant;
$out.0.receipt_file=$in.0.receipt_file;
$out.0.receipt_row=$in.0.receipt_row == null ? null : num2str($in.0.receipt_row);
$out.0.receipt_received=$in.0.receipt_received == null ? null : date2str($in.0.receipt_received,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.receipt_team=$in.0.receipt_team;
$out.0.receipt_market=$in.0.receipt_market;
$out.0.receipt_currency=$in.0.receipt_currency;
$out.0.receipt_batch=$in.0.receipt_batch;
$out.0.receipt_note=$in.0.receipt_note;
$out.0.receipt_trace=$in.0.receipt_trace;
$out.0.receipt_unused_archive=$in.0.receipt_unused_archive;
$out.0.merchant_cd=$in.0.merchant_cd;
$out.0.transaction_ref=$in.0.transaction_ref;
$out.0.posted_amount=$in.0.posted_amount == null ? null : num2str($in.0.posted_amount,"0.00","en.US");
$out.0.posting_dt=$in.0.posting_dt == null ? null : date2str($in.0.posting_dt,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.run_id=$in.0.run_id;
$out.0.run_ts=$in.0.run_ts == null ? null : date2str($in.0.run_ts,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.audit_seq=$in.0.audit_seq == null ? null : num2str($in.0.audit_seq);
$out.0.record_digest=$in.0.record_digest;
$out.0.audit_source=$in.0.audit_source;
return OK;}</attr>
