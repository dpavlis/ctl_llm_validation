    <Node id="Test" type="DENORMALIZER" enabled="enabled" guiName="Test" guiX="500" guiY="200">
      <attr name="key">business_ref</attr>
      <attr name="charset">UTF-8</attr>
      <attr name="denormalize">//#CTL2
string first_business_ref;
string first_tenant_cd;
string first_source_file;
long first_source_row;
date first_received_at;
string first_currency_cd;
string first_operator_note;
string first_market_cd;
string first_owner_team;
string first_trace_id;
string first_unused_archive_label;
decimal first_context_value;
string[] slots;
decimal[] units;
date[] times;
decimal[] costs;
integer n;
function integer append() {
 if(n==0) {first_business_ref=$in.0.business_ref;first_tenant_cd=$in.0.tenant_cd;first_source_file=$in.0.source_file;first_source_row=$in.0.source_row;first_received_at=$in.0.received_at;first_currency_cd=$in.0.currency_cd;first_operator_note=$in.0.operator_note;first_market_cd=$in.0.market_cd;first_owner_team=$in.0.owner_team;first_trace_id=$in.0.trace_id;first_unused_archive_label=$in.0.unused_archive_label;first_context_value=$in.0.context_value;}n++;
 string id=$in.0.slot_id;
 if(isnull(id) || trim(id)=="") return OK;
 if($in.0.operation=="REMOVE") {for(integer j=length(slots)-1;j&gt;=0;j--) {if(slots[j]==id) {remove(slots,j);remove(units,j);remove(times,j);remove(costs,j);}}}
 else if($in.0.operation=="ADD") {string text=isnull($in.0.units_txt) ? "" : trim($in.0.units_txt);if(text ~= "[0-9]{1,9}(\\.[0-9]{1,2})?") {decimal q=str2decimal(text);if(q&gt;0D) {append(slots,id);append(units,q);append(times,$in.0.observed_at);append(costs,$in.0.unit_cost);}}}
 return OK;
}
function integer transform() {
 integer pick=-1;
 for(integer j=0;j&lt;length(slots);j++) {boolean better=pick&lt;0;if(pick&gt;=0) {if(units[j]&gt;units[pick]) better=true;else if(units[j]==units[pick]) {if(!isnull(times[j]) &amp;&amp; isnull(times[pick])) better=true;else if(!isnull(times[j]) &amp;&amp; !isnull(times[pick]) &amp;&amp; times[j]&gt;times[pick]) better=true;}}if(better) pick=j;}
 $out.0.business_ref=first_business_ref;$out.0.tenant_cd=first_tenant_cd;$out.0.source_file=first_source_file;$out.0.source_row=first_source_row;$out.0.received_at=first_received_at;$out.0.currency_cd=first_currency_cd;$out.0.operator_note=first_operator_note;$out.0.market_cd=first_market_cd;$out.0.owner_team=first_owner_team;$out.0.trace_id=first_trace_id;$out.0.unused_archive_label=first_unused_archive_label;$out.0.context_value=first_context_value;$out.0.rows_seen=n;$out.0.surviving_slots=join(",",slots);
 $out.0.chosen_slot=pick&lt;0 ? null : slots[pick];$out.0.chosen_at=pick&lt;0 ? null : times[pick];$out.0.chosen_units=pick&lt;0 ? null : units[pick];$out.0.chosen_cost=pick&lt;0 ? null : costs[pick];return OK;
}
function void clean() {n=0;clear(slots);clear(units);clear(times);clear(costs);}</attr>
    </Node>
    <Node id="Encode0" type="REFORMAT" enabled="enabled" guiName="Encode0" guiX="725" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.business_ref=$in.0.business_ref;
$out.0.tenant_cd=$in.0.tenant_cd;
$out.0.source_file=$in.0.source_file;
$out.0.source_row=$in.0.source_row == null ? null : num2str($in.0.source_row);
$out.0.received_at=$in.0.received_at == null ? null : date2str($in.0.received_at,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.currency_cd=$in.0.currency_cd;
$out.0.operator_note=$in.0.operator_note;
$out.0.market_cd=$in.0.market_cd;
$out.0.owner_team=$in.0.owner_team;
$out.0.trace_id=$in.0.trace_id;
$out.0.unused_archive_label=$in.0.unused_archive_label;
$out.0.context_value=$in.0.context_value == null ? null : num2str($in.0.context_value,"0.00","en.US");
$out.0.chosen_slot=$in.0.chosen_slot;
$out.0.chosen_at=$in.0.chosen_at == null ? null : date2str($in.0.chosen_at,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.chosen_units=$in.0.chosen_units == null ? null : num2str($in.0.chosen_units,"0.00","en.US");
$out.0.chosen_cost=$in.0.chosen_cost == null ? null : num2str($in.0.chosen_cost,"0.00","en.US");
$out.0.surviving_slots=$in.0.surviving_slots;
$out.0.rows_seen=$in.0.rows_seen == null ? null : num2str($in.0.rows_seen);
return OK;}</attr>
