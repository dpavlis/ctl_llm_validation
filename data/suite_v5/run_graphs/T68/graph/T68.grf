$out.0.gross_amount=$in.0.gross_amount == null ? null : num2str($in.0.gross_amount,"0.00","en.US");
$out.0.discount_percent=$in.0.discount_percent == null ? null : num2str($in.0.discount_percent,"0.00","en.US");
$out.0.surcharge_amount=$in.0.surcharge_amount == null ? null : num2str($in.0.surcharge_amount,"0.00","en.US");
$out.0.budget_amount=$in.0.budget_amount == null ? null : num2str($in.0.budget_amount,"0.00","en.US");
$out.0.document_dt=$in.0.document_dt == null ? null : date2str($in.0.document_dt,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
