      <attr name="transform">//#CTL2
function integer transform(){
$out.0.invoice_key=$in.0.invoice_key;
$out.0.invoice_tenant=$in.0.invoice_tenant;
$out.0.invoice_file=$in.0.invoice_file;
$out.0.invoice_row=$in.0.invoice_row == null ? null : str2long($in.0.invoice_row);
$out.0.invoice_received=$in.0.invoice_received == null ? null : str2date($in.0.invoice_received,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.invoice_team=$in.0.invoice_team;
$out.0.invoice_market=$in.0.invoice_market;
$out.0.invoice_currency=$in.0.invoice_currency;
$out.0.invoice_batch=$in.0.invoice_batch;
$out.0.invoice_note=$in.0.invoice_note;
$out.0.invoice_trace=$in.0.invoice_trace;
$out.0.invoice_unused_archive=$in.0.invoice_unused_archive;
$out.0.raw_code=$in.0.raw_code;
$out.0.gross_amount=$in.0.gross_amount == null ? null : str2decimal($in.0.gross_amount);
$out.0.discount_percent=$in.0.discount_percent == null ? null : str2decimal($in.0.discount_percent);
$out.0.surcharge_amount=$in.0.surcharge_amount == null ? null : str2decimal($in.0.surcharge_amount);
$out.0.budget_amount=$in.0.budget_amount == null ? null : str2decimal($in.0.budget_amount);
$out.0.document_dt=$in.0.document_dt == null ? null : str2date($in.0.document_dt,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
return OK;}</attr>
