    <Node id="Decode0" type="REFORMAT" enabled="enabled" guiName="Decode0" guiX="275" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.treasury_batch=$in.0.treasury_batch;
$out.0.treasury_loaded=$in.0.treasury_loaded == null ? null : str2date($in.0.treasury_loaded,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.treasury_ledger=$in.0.treasury_ledger == null ? null : str2decimal($in.0.treasury_ledger);
$out.0.treasury_unused=$in.0.treasury_unused;
$out.0.treasury_note=$in.0.treasury_note;
$out.0.treasury_row=$in.0.treasury_row == null ? null : str2long($in.0.treasury_row);
$out.0.old_account=$in.0.old_account;
$out.0.entry_kind=$in.0.entry_kind;
$out.0.opening_balance=$in.0.opening_balance == null ? null : str2decimal($in.0.opening_balance);
$out.0.movement_amount=$in.0.movement_amount == null ? null : str2decimal($in.0.movement_amount);
$out.0.posting_time=$in.0.posting_time == null ? null : str2date($in.0.posting_time,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.memo_text=$in.0.memo_text;
return OK;}</attr>
    </Node>
