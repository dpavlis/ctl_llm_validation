    <Node id="Test" type="REFORMAT" enabled="enabled" guiName="Test" guiX="500" guiY="200">
      <attr name="charset">UTF-8</attr>
      <attr name="transform">//#CTL2
boolean seen=false;string previous;decimal balance;integer ordinal;function integer transform(){string k=trim($in.0.old_account);if(!seen||k!=previous){balance=0D;ordinal=0;previous=k;seen=true;}string kind=upperCase(trim(nvl($in.0.entry_kind,"")));string status="OK";if(kind=="OPEN")balance=nvl($in.0.opening_balance,0D);else if(kind=="MOVE"){if($in.0.movement_amount==null)status="MISSING_AMOUNT";else balance+= $in.0.movement_amount;}else if(kind=="CLOSE"){balance=0D;status="CLOSED";}else status="UNKNOWN_KIND";ordinal++;$out.0.*=$in.0.*;$out.0.account_key=k;$out.0.migrated_balance=balance;$out.0.migration_status=status;$out.0.account_entry_no=ordinal;return OK;}</attr>
    </Node>
    <Node id="Encode0" type="REFORMAT" enabled="enabled" guiName="Encode0" guiX="725" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.treasury_batch=$in.0.treasury_batch;
$out.0.treasury_loaded=$in.0.treasury_loaded == null ? null : date2str($in.0.treasury_loaded,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.treasury_ledger=$in.0.treasury_ledger == null ? null : num2str($in.0.treasury_ledger,"0.00","en.US");
$out.0.treasury_unused=$in.0.treasury_unused;
$out.0.treasury_note=$in.0.treasury_note;
$out.0.treasury_row=$in.0.treasury_row == null ? null : num2str($in.0.treasury_row);
$out.0.old_account=$in.0.old_account;
$out.0.entry_kind=$in.0.entry_kind;
$out.0.opening_balance=$in.0.opening_balance == null ? null : num2str($in.0.opening_balance,"0.00","en.US");
$out.0.movement_amount=$in.0.movement_amount == null ? null : num2str($in.0.movement_amount,"0.00","en.US");
$out.0.posting_time=$in.0.posting_time == null ? null : date2str($in.0.posting_time,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.memo_text=$in.0.memo_text;
$out.0.account_key=$in.0.account_key;
$out.0.migrated_balance=$in.0.migrated_balance == null ? null : num2str($in.0.migrated_balance,"0.00","en.US");
$out.0.migration_status=$in.0.migration_status;
$out.0.account_entry_no=$in.0.account_entry_no == null ? null : num2str($in.0.account_entry_no);
return OK;}</attr>
