    <Node id="Test" type="REFORMAT" enabled="enabled" guiName="Test" guiX="500" guiY="200">
      <attr name="charset">UTF-8</attr>
      <attr name="transform">//#CTL2
function integer transform(){
 string[] reasons=[];string m=trim(nvl($in.0.invoice_limit_txt,""));string d=trim(nvl($in.0.activation_dt_txt,""));string term=upperCase(trim(nvl($in.0.payment_term_txt,"")));string p="yyyy-MM-dd";boolean good=false;
 if(d ~= "[0-9]{4}-[0-9]{2}-[0-9]{2}")good=isDate(d,p,"en.US","UTC",true);
 else if(d ~= "[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}"){p="yyyy-MM-dd HH:mm:ss";good=isDate(d,p,"en.US","UTC",true);}
 if(trim($in.0.vendor_ref_no)=="")append(reasons,"REF");if(!(m ~= "[0-9]{1,12}(\\.[0-9]{1,2})?"))append(reasons,"LIMIT");if(!good)append(reasons,"DATE");if(!(term=="NET30"||term=="NET60"))append(reasons,"TERM");
 if(length(reasons)&gt;0){$out.1.*=$in.0.*;$out.1.reject_reason=join(";",reasons);return 1;}
 $out.0.*=$in.0.*;$out.0.approved_amount=str2decimal(m);$out.0.effective_dt=str2date(d,p,"en.US","UTC",true);$out.0.business_code=term;return 0;
}</attr>
    </Node>
