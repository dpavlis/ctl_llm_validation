    <Node id="Decode0" type="REFORMAT" enabled="enabled" guiName="Decode0" guiX="275" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.vendor_batch=$in.0.vendor_batch;
$out.0.vendor_loaded=$in.0.vendor_loaded == null ? null : str2date($in.0.vendor_loaded,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.vendor_ledger=$in.0.vendor_ledger == null ? null : str2decimal($in.0.vendor_ledger);
$out.0.vendor_unused=$in.0.vendor_unused;
$out.0.vendor_note=$in.0.vendor_note;
$out.0.vendor_row=$in.0.vendor_row == null ? null : str2long($in.0.vendor_row);
$out.0.vendor_ref_no=$in.0.vendor_ref_no;
$out.0.invoice_limit_txt=$in.0.invoice_limit_txt;
$out.0.activation_dt_txt=$in.0.activation_dt_txt;
$out.0.payment_term_txt=$in.0.payment_term_txt;
$out.0.contact_email=$in.0.contact_email;
$out.0.address_line2=$in.0.address_line2;
$out.0.vendor_contact_nm=$in.0.vendor_contact_nm;
$out.0.vendor_contact_phone=$in.0.vendor_contact_phone;
$out.0.vendor_address_line1=$in.0.vendor_address_line1;
$out.0.vendor_postal_cd=$in.0.vendor_postal_cd;
$out.0.vendor_country_cd=$in.0.vendor_country_cd;
$out.0.vendor_bank_ref=$in.0.vendor_bank_ref;
$out.0.vendor_tax_ref=$in.0.vendor_tax_ref;
$out.0.vendor_branch_cd=$in.0.vendor_branch_cd;
$out.0.vendor_sales_rep=$in.0.vendor_sales_rep;
$out.0.vendor_remittance_note=$in.0.vendor_remittance_note;
$out.0.vendor_legal_entity=$in.0.vendor_legal_entity;
return OK;}</attr>
