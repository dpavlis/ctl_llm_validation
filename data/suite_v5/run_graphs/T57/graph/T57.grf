      <attr name="groupKeyFields">business_ref</attr>
      <attr name="groupAccumulatorMetadataId">Accumulator</attr>
      <attr name="transform">//#CTL2
string w_business_ref;
string w_tenant_cd;
string w_source_file;
long w_source_row;
date w_received_at;
string w_currency_cd;
string w_operator_note;
string w_market_cd;
string w_owner_team;
string w_trace_id;
string w_unused_archive_label;
decimal w_context_value;
string w_receipt_id;
decimal w_amount;
boolean w_voided;
string[] seen_ids;
string disposition;
string winner_id;
function void initGroup(ReceiptAcc acc) {clear(seen_ids);acc.n=0;acc.accepted=0;acc.has_winner=false;winner_id=null;}
function boolean updateGroup(ReceiptAcc acc) {
 acc.n++;
 if(isnull($in.0.receipt_id) || trim($in.0.receipt_id)=="") disposition="INVALID";
 else if(in($in.0.receipt_id,seen_ids)) disposition="DUPLICATE";
 else {append(seen_ids,$in.0.receipt_id);
  if($in.0.voided || isnull($in.0.amount) || $in.0.amount&lt;=0D) disposition="INELIGIBLE";
  else {acc.accepted++;disposition="ELIGIBLE";if(!acc.has_winner) {w_business_ref=$in.0.business_ref;w_tenant_cd=$in.0.tenant_cd;w_source_file=$in.0.source_file;w_source_row=$in.0.source_row;w_received_at=$in.0.received_at;w_currency_cd=$in.0.currency_cd;w_operator_note=$in.0.operator_note;w_market_cd=$in.0.market_cd;w_owner_team=$in.0.owner_team;w_trace_id=$in.0.trace_id;w_unused_archive_label=$in.0.unused_archive_label;w_context_value=$in.0.context_value;w_receipt_id=$in.0.receipt_id;w_amount=$in.0.amount;w_voided=$in.0.voided;acc.has_winner=true;winner_id=$in.0.receipt_id;disposition="WINNER";}}
 }
 return true;
}
function integer updateTransform(integer counter,ReceiptAcc acc) {if(counter&gt;0) return SKIP;$out.0.*=$in.0.*;$out.0.disposition=disposition;$out.0.winner_receipt=winner_id;$out.0.rows_seen=acc.n;return 0;}
function boolean finishGroup(ReceiptAcc acc) {return acc.has_winner;}
function integer transform(integer counter,ReceiptAcc acc) {if(counter&gt;0) return SKIP;$out.1.business_ref=w_business_ref;$out.1.tenant_cd=w_tenant_cd;$out.1.source_file=w_source_file;$out.1.source_row=w_source_row;$out.1.received_at=w_received_at;$out.1.currency_cd=w_currency_cd;$out.1.operator_note=w_operator_note;$out.1.market_cd=w_market_cd;$out.1.owner_team=w_owner_team;$out.1.trace_id=w_trace_id;$out.1.unused_archive_label=w_unused_archive_label;$out.1.context_value=w_context_value;$out.1.receipt_id=w_receipt_id;$out.1.amount=w_amount;$out.1.voided=w_voided;$out.1.disposition="CHOSEN";$out.1.winner_receipt=winner_id;$out.1.rows_seen=acc.n;return 1;}</attr>
    </Node>
