    <Node id="Decode0" type="REFORMAT" enabled="enabled" guiName="Decode0" guiX="275" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.business_ref=$in.0.business_ref;
$out.0.tenant_cd=$in.0.tenant_cd;
$out.0.source_file=$in.0.source_file;
$out.0.source_row=$in.0.source_row == null ? null : str2long($in.0.source_row);
$out.0.received_at=$in.0.received_at == null ? null : str2date($in.0.received_at,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.currency_cd=$in.0.currency_cd;
$out.0.operator_note=$in.0.operator_note;
$out.0.market_cd=$in.0.market_cd;
$out.0.owner_team=$in.0.owner_team;
$out.0.trace_id=$in.0.trace_id;
$out.0.unused_archive_label=$in.0.unused_archive_label;
$out.0.context_value=$in.0.context_value == null ? null : str2decimal($in.0.context_value);
$out.0.receipt_id=$in.0.receipt_id;
$out.0.amount=$in.0.amount == null ? null : str2decimal($in.0.amount);
$out.0.voided=$in.0.voided == null ? null : str2bool($in.0.voided);
return OK;}</attr>
