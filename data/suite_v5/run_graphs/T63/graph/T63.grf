    <Node id="Test" type="ROLLUP" enabled="enabled" guiName="Test" guiX="500" guiY="200">
      <attr name="groupKeyFields">business_ref</attr>
      <attr name="groupAccumulatorMetadataId">Accumulator</attr>
      <attr name="transform">//#CTL2
string first_business_ref;
string first_tenant_cd;
string first_source_file;
long first_source_row;
date first_received_at;
string first_currency_cd;
string first_operator_note;
string first_market_cd;
string first_owner_team;
string first_trace_id;
string first_unused_archive_label;
decimal first_context_value;
boolean first_audit;
date first_date;
function void initGroup(ExposureAcc acc) {first_business_ref=$in.0.business_ref;first_tenant_cd=$in.0.tenant_cd;first_source_file=$in.0.source_file;first_source_row=$in.0.source_row;first_received_at=$in.0.received_at;first_currency_cd=$in.0.currency_cd;first_operator_note=$in.0.operator_note;first_market_cd=$in.0.market_cd;first_owner_team=$in.0.owner_team;first_trace_id=$in.0.trace_id;first_unused_archive_label=$in.0.unused_archive_label;first_context_value=$in.0.context_value;first_audit=$in.0.audit_required;first_date=$in.0.valuation_at;acc.n=0;acc.eligible=0;acc.excluded=0;acc.days=0;acc.high_days=0;acc.weighted_total=0D;}
function boolean updateGroup(ExposureAcc acc) {
 acc.n++;boolean eligible=$in.0.quote_currency==$in.0.currency_cd &amp;&amp; !isnull($in.0.coverage_days) &amp;&amp; $in.0.coverage_days&gt;0 &amp;&amp; !isnull($in.0.asset_value);decimal haircut=0D;
 if(eligible) {string text=isnull($in.0.haircut_txt) ? "" : trim($in.0.haircut_txt);if(text!="") {if(!(text ~= "[0-9]{1,3}(\\.[0-9]{1,2})?")) eligible=false;else {haircut=str2decimal(text);if(haircut&gt;100D) eligible=false;}}}
 if(!eligible) {acc.excluded++;return false;}
 acc.eligible++;acc.days+=$in.0.coverage_days;if($in.0.risk_grade=="HIGH") acc.high_days+=$in.0.coverage_days;
 acc.weighted_total+=$in.0.asset_value*(100D-haircut)/100D*$in.0.coverage_days;return false;
}
function integer updateTransform(integer counter,ExposureAcc acc) {return SKIP;}
function boolean finishGroup(ExposureAcc acc) {return acc.eligible&gt;0 || first_audit;}
function integer transform(integer counter,ExposureAcc acc) {if(counter&gt;0) return SKIP;$out.0.business_ref=first_business_ref;$out.0.tenant_cd=first_tenant_cd;$out.0.source_file=first_source_file;$out.0.source_row=first_source_row;$out.0.received_at=first_received_at;$out.0.currency_cd=first_currency_cd;$out.0.operator_note=first_operator_note;$out.0.market_cd=first_market_cd;$out.0.owner_team=first_owner_team;$out.0.trace_id=first_trace_id;$out.0.unused_archive_label=first_unused_archive_label;$out.0.context_value=first_context_value;integer m=getMonth(first_date,"UTC");integer y=getYear(first_date,"UTC");integer q;
 if(m&lt;4) {y--;q=4;}else q=(m-4)/3+1;
 $out.0.fiscal_period=num2str(y)+"-Q"+num2str(q);$out.0.rows_seen=acc.n;$out.0.eligible_rows=acc.eligible;$out.0.excluded_rows=acc.excluded;$out.0.weighted_days=acc.days;
 $out.0.adjusted_average=acc.days==0 ? null : round(acc.weighted_total/acc.days,3);$out.0.high_share=acc.days==0 ? 0D : round(100D*acc.high_days/acc.days,2);return OK;
}</attr>
    </Node>
