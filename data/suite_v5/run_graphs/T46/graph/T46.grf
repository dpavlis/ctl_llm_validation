    <Node id="Test" type="REFORMAT" enabled="enabled" guiName="Test" guiX="500" guiY="200">
      <attr name="charset">UTF-8</attr>
      <attr name="transform">//#CTL2
function integer transform(){string[] e=[];string m=upperCase(trim(nvl($in.0.movement_txt,"")));boolean mode=m=="SHIP"||m=="REVERSE";if(!mode)append(e,"MOVEMENT");string q=trim(nvl($in.0.quantity_txt,""));boolean qOK=q ~= "-?[0-9]{1,6}";integer qty=0;if(qOK){qty=str2integer(q);qOK=qty!=0&amp;&amp;(m!="SHIP"||qty&gt;0)&amp;&amp;(m!="REVERSE"||qty&lt;0);}if(!qOK)append(e,"QTY");string v=trim(nvl($in.0.unit_value_txt,""));if(!(v ~= "[0-9]{1,8}(\\.[0-9]{1,2})?"))append(e,"VALUE");string orig=trim(nvl($in.0.original_manifest,""));if(m=="REVERSE"&amp;&amp;(orig==""||orig==trim($in.0.manifest_id)))append(e,"ORIGINAL");string d=nvl($in.0.dispatch_txt,"");boolean dOK=d ~= "[0-9]{8}";if(dOK)dOK=isDate(d,"yyyyMMdd","en.US","UTC",true);if(!dOK)append(e,"DISPATCH");if(length(e)&gt;0){$out.1.*=$in.0.*;$out.1.defect_list=join("|",e);return 1;}$out.0.*=$in.0.*;$out.0.signed_quantity=qty;$out.0.declared_value=qty*str2decimal(v);$out.0.dispatch_day=str2date(d,"yyyyMMdd","en.US","UTC",true);return 0;}</attr>
    </Node>
