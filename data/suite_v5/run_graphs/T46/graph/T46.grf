    <Node id="Decode0" type="REFORMAT" enabled="enabled" guiName="Decode0" guiX="275" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.cargo_batch=$in.0.cargo_batch;
$out.0.cargo_loaded=$in.0.cargo_loaded == null ? null : str2date($in.0.cargo_loaded,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.cargo_ledger=$in.0.cargo_ledger == null ? null : str2decimal($in.0.cargo_ledger);
$out.0.cargo_unused=$in.0.cargo_unused;
$out.0.cargo_note=$in.0.cargo_note;
$out.0.cargo_row=$in.0.cargo_row == null ? null : str2long($in.0.cargo_row);
$out.0.manifest_id=$in.0.manifest_id;
$out.0.movement_txt=$in.0.movement_txt;
$out.0.quantity_txt=$in.0.quantity_txt;
$out.0.unit_value_txt=$in.0.unit_value_txt;
$out.0.original_manifest=$in.0.original_manifest;
$out.0.dispatch_txt=$in.0.dispatch_txt;
$out.0.cargo_consignee_name=$in.0.cargo_consignee_name;
$out.0.cargo_shipper_name=$in.0.cargo_shipper_name;
$out.0.cargo_origin_country=$in.0.cargo_origin_country;
$out.0.cargo_border_office=$in.0.cargo_border_office;
$out.0.cargo_seal_no=$in.0.cargo_seal_no;
