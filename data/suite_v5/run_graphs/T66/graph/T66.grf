    <Node id="Decode0" type="REFORMAT" enabled="enabled" guiName="Decode0" guiX="275" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.payment_key=$in.0.payment_key;
$out.0.payment_tenant=$in.0.payment_tenant;
$out.0.payment_file=$in.0.payment_file;
$out.0.payment_row=$in.0.payment_row == null ? null : str2long($in.0.payment_row);
$out.0.payment_received=$in.0.payment_received == null ? null : str2date($in.0.payment_received,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.payment_team=$in.0.payment_team;
$out.0.payment_market=$in.0.payment_market;
$out.0.payment_currency=$in.0.payment_currency;
$out.0.payment_batch=$in.0.payment_batch;
$out.0.payment_note=$in.0.payment_note;
$out.0.payment_trace=$in.0.payment_trace;
$out.0.payment_unused_archive=$in.0.payment_unused_archive;
$out.0.status_cd=$in.0.status_cd;
$out.0.hold_flag=$in.0.hold_flag == null ? null : str2bool($in.0.hold_flag);
$out.0.amount_txt=$in.0.amount_txt;
$out.0.invoice_day_txt=$in.0.invoice_day_txt;
$out.0.priority_cd=$in.0.priority_cd;
$out.0.insured_value=$in.0.insured_value == null ? null : str2decimal($in.0.insured_value);
$out.0.due_at=$in.0.due_at == null ? null : str2date($in.0.due_at,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
return OK;}</attr>
    </Node>
    <Edge id="Read0" fromNode="Reader0:0" toNode="Decode0:0" metadata="RawIn0" guiRouter="Manhattan" inPort="Port 0 (in)" outPort="Port 0 (out)" />
