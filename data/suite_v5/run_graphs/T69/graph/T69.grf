    <Node id="Decode0" type="REFORMAT" enabled="enabled" guiName="Decode0" guiX="275" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.meter_key=$in.0.meter_key;
$out.0.meter_tenant=$in.0.meter_tenant;
$out.0.meter_file=$in.0.meter_file;
$out.0.meter_row=$in.0.meter_row == null ? null : str2long($in.0.meter_row);
$out.0.meter_received=$in.0.meter_received == null ? null : str2date($in.0.meter_received,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.meter_team=$in.0.meter_team;
$out.0.meter_market=$in.0.meter_market;
$out.0.meter_currency=$in.0.meter_currency;
$out.0.meter_batch=$in.0.meter_batch;
$out.0.meter_note=$in.0.meter_note;
$out.0.meter_trace=$in.0.meter_trace;
$out.0.meter_unused_archive=$in.0.meter_unused_archive;
$out.0.current_text=$in.0.current_text;
$out.0.previous_text=$in.0.previous_text;
$out.0.unit_code=$in.0.unit_code;
$out.0.meter_status=$in.0.meter_status;
$out.0.calibration_factor=$in.0.calibration_factor == null ? null : str2decimal($in.0.calibration_factor);
$out.0.captured_at=$in.0.captured_at == null ? null : str2date($in.0.captured_at,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
return OK;}</attr>
    </Node>
    <Edge id="Read0" fromNode="Reader0:0" toNode="Decode0:0" metadata="RawIn0" guiRouter="Manhattan" inPort="Port 0 (in)" outPort="Port 0 (out)" />
