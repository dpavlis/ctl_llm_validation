    <Node id="Test" type="REFORMAT" enabled="enabled" guiName="Test" guiX="500" guiY="200">
      <attr name="charset">UTF-8</attr>
      <attr name="transform">//#CTL2
function decimal readingValue(string text){string raw=trim(nvl(text,""));if(!(raw ~= "-?[0-9]{1,5}(\\.[0-9]{1,2})?"))return null;return str2decimal(raw);}
function decimal readingDelta(string newer,string older){decimal n=readingValue(newer);decimal o=readingValue(older);return isnull(n)||isnull(o) ? null : n-o;}
function string deltaStatus(string newer,string older){decimal n=readingValue(newer);decimal o=readingValue(older);if(!isBlank(newer)&amp;&amp;isnull(n))return "NEW_BAD";if(!isBlank(older)&amp;&amp;isnull(o))return "OLD_BAD";if(isnull(n)||isnull(o))return "MISSING";if(n&lt;o)return "RESET";return n==o ? "SAME" : "ADVANCE";}
function string readingLabel(string unit,string text){decimal value=readingValue(text);return isnull(unit)||isnull(value) ? null : upperCase(trim(unit))+":"+num2str(value,"0.00","en.US");}
function integer transform(){$out.0.*=$in.0.*;$out.0.current_value=readingValue($in.0.current_text);$out.0.delta_value=readingDelta($in.0.current_text,$in.0.previous_text);$out.0.delta_status=deltaStatus($in.0.current_text,$in.0.previous_text);$out.0.reading_label=readingLabel($in.0.unit_code,$in.0.current_text);return OK;}
</attr>
    </Node>
    <Node id="Encode0" type="REFORMAT" enabled="enabled" guiName="Encode0" guiX="725" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.meter_key=$in.0.meter_key;
$out.0.meter_tenant=$in.0.meter_tenant;
$out.0.meter_file=$in.0.meter_file;
$out.0.meter_row=$in.0.meter_row == null ? null : num2str($in.0.meter_row);
$out.0.meter_received=$in.0.meter_received == null ? null : date2str($in.0.meter_received,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.meter_team=$in.0.meter_team;
$out.0.meter_market=$in.0.meter_market;
$out.0.meter_currency=$in.0.meter_currency;
$out.0.meter_batch=$in.0.meter_batch;
$out.0.meter_note=$in.0.meter_note;
$out.0.meter_trace=$in.0.meter_trace;
$out.0.meter_unused_archive=$in.0.meter_unused_archive;
$out.0.current_text=$in.0.current_text;
$out.0.previous_text=$in.0.previous_text;
$out.0.unit_code=$in.0.unit_code;
$out.0.meter_status=$in.0.meter_status;
$out.0.calibration_factor=$in.0.calibration_factor == null ? null : num2str($in.0.calibration_factor,"0.00","en.US");
$out.0.captured_at=$in.0.captured_at == null ? null : date2str($in.0.captured_at,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.current_value=$in.0.current_value == null ? null : num2str($in.0.current_value,"0.00","en.US");
$out.0.delta_value=$in.0.delta_value == null ? null : num2str($in.0.delta_value,"0.00","en.US");
$out.0.delta_status=$in.0.delta_status;
$out.0.reading_label=$in.0.reading_label;
return OK;}</attr>
