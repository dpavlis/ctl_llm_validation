    <Node id="Decode0" type="REFORMAT" enabled="enabled" guiName="Decode0" guiX="275" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.property_batch=$in.0.property_batch;
$out.0.property_loaded=$in.0.property_loaded == null ? null : str2date($in.0.property_loaded,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.property_ledger=$in.0.property_ledger == null ? null : str2decimal($in.0.property_ledger);
$out.0.property_unused=$in.0.property_unused;
$out.0.property_note=$in.0.property_note;
$out.0.property_row=$in.0.property_row == null ? null : str2long($in.0.property_row);
$out.0.old_parcel_id=$in.0.old_parcel_id;
$out.0.owners_txt=$in.0.owners_txt;
$out.0.tenure_txt=$in.0.tenure_txt;
$out.0.street_label=$in.0.street_label;
$out.0.registered_at=$in.0.registered_at == null ? null : str2date($in.0.registered_at,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.assessed_value=$in.0.assessed_value == null ? null : str2decimal($in.0.assessed_value);
return OK;}</attr>
    </Node>
    <Edge id="Read0" fromNode="Reader0:0" toNode="Decode0:0" metadata="RawIn0" guiRouter="Manhattan" inPort="Port 0 (in)" outPort="Port 0 (out)" />
