    <Node id="Test" type="NORMALIZER" enabled="enabled" guiName="Test" guiX="500" guiY="200">
      <attr name="charset">UTF-8</attr>
      <attr name="normalize">//#CTL2
string[] owners;map[string,boolean] seen;string tenure;string parcel;boolean missing;InputT48 parent;
 function integer count(){parent=$in.0;clear(owners);clear(seen);string raw=nvl($in.0.owners_txt,"");string[] parts=split(raw,";");foreach(string part:parts){string v=trim(part);string k=upperCase(v);if(v!=""&amp;&amp;!containsKey(seen,k)){append(owners,v);seen[k]=true;}}missing=length(owners)==0;if(missing)append(owners,"UNKNOWN_OWNER");parcel=trim($in.0.old_parcel_id);if(parcel=="")parcel="UNKNOWN_PARCEL";string t=upperCase(trim(nvl($in.0.tenure_txt,"")));tenure=t=="F"?"FREEHOLD":t=="L"?"LEASEHOLD":"UNVERIFIED";return length(owners);}
 function integer transform(integer idx){$out.0.*=parent.*;$out.0.parcel_number=parcel;$out.0.owner_name=owners[idx];$out.0.owner_ordinal=idx+1;$out.0.owner_total=length(owners);$out.0.tenure_code=tenure;$out.0.owner_missing=missing;return OK;}
 function void clean(){clear(owners);clear(seen);}</attr>
    </Node>
    <Node id="Encode0" type="REFORMAT" enabled="enabled" guiName="Encode0" guiX="725" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.property_batch=$in.0.property_batch;
$out.0.property_loaded=$in.0.property_loaded == null ? null : date2str($in.0.property_loaded,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.property_ledger=$in.0.property_ledger == null ? null : num2str($in.0.property_ledger,"0.00","en.US");
$out.0.property_unused=$in.0.property_unused;
$out.0.property_note=$in.0.property_note;
$out.0.property_row=$in.0.property_row == null ? null : num2str($in.0.property_row);
$out.0.street_label=$in.0.street_label;
$out.0.registered_at=$in.0.registered_at == null ? null : date2str($in.0.registered_at,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.assessed_value=$in.0.assessed_value == null ? null : num2str($in.0.assessed_value,"0.00","en.US");
$out.0.parcel_number=$in.0.parcel_number;
$out.0.owner_name=$in.0.owner_name;
$out.0.owner_ordinal=$in.0.owner_ordinal == null ? null : num2str($in.0.owner_ordinal);
$out.0.owner_total=$in.0.owner_total == null ? null : num2str($in.0.owner_total);
$out.0.tenure_code=$in.0.tenure_code;
$out.0.owner_missing=$in.0.owner_missing == null ? null : ($in.0.owner_missing ? "true" : "false");
return OK;}</attr>
    </Node>
