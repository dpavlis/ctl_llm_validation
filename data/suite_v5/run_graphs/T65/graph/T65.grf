    <Node id="Test" type="NORMALIZER" enabled="enabled" guiName="Test" guiX="500" guiY="200">
      <attr name="charset">UTF-8</attr>
      <attr name="normalize">//#CTL2
variant channels;
string[] keys;
function integer count(){
 channels=null;clear(keys);
 if (isnull($in.0.channels_json) || trim($in.0.channels_json)=="") return 0;
 variant root=parseJson($in.0.channels_json);
 if (!containsKey(root,"channels") || isnull(root["channels"])) return 0;
 channels=root["channels"];
 foreach(variant key:getKeys(channels)) append(keys,cast(key,string));
 keys=sort(keys);return length(keys);
}
function integer transform(integer idx){
 variant entry=channels[keys[idx]];
 if (containsKey(entry,"enabled") &amp;&amp; !isnull(entry["enabled"]) &amp;&amp; !cast(entry["enabled"],boolean)) return SKIP;
 $out.0.*=$in.0.*;$out.0.channel_name=keys[idx];$out.0.position=idx+1;
 $out.0.reading_value=null;$out.0.quality_cd="MISSING";
 if (!containsKey(entry,"value") || isnull(entry["value"])) return OK;
 string raw=trim(cast(entry["value"],string));if(raw=="") return OK;
 if (!(raw ~= "-?[0-9]{1,6}(\\.[0-9]{1,2})?")) {$out.0.quality_cd="BAD_TEXT";return OK;}
 $out.0.reading_value=str2decimal(raw);$out.0.quality_cd="GOOD";return OK;
}
function void clean(){channels=null;clear(keys);}
</attr>
    </Node>
    <Node id="Encode0" type="REFORMAT" enabled="enabled" guiName="Encode0" guiX="725" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.machine_key=$in.0.machine_key;
$out.0.machine_tenant=$in.0.machine_tenant;
$out.0.machine_file=$in.0.machine_file;
$out.0.machine_row=$in.0.machine_row == null ? null : num2str($in.0.machine_row);
$out.0.machine_received=$in.0.machine_received == null ? null : date2str($in.0.machine_received,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.machine_team=$in.0.machine_team;
$out.0.machine_market=$in.0.machine_market;
$out.0.machine_currency=$in.0.machine_currency;
$out.0.machine_batch=$in.0.machine_batch;
$out.0.machine_note=$in.0.machine_note;
$out.0.machine_trace=$in.0.machine_trace;
$out.0.machine_unused_archive=$in.0.machine_unused_archive;
$out.0.rated_capacity=$in.0.rated_capacity == null ? null : num2str($in.0.rated_capacity,"0.00","en.US");
$out.0.commissioned_on=$in.0.commissioned_on == null ? null : date2str($in.0.commissioned_on,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC");
$out.0.channel_name=$in.0.channel_name;
$out.0.position=$in.0.position == null ? null : num2str($in.0.position);
$out.0.reading_value=$in.0.reading_value == null ? null : num2str($in.0.reading_value,"0.00","en.US");
$out.0.quality_cd=$in.0.quality_cd;
return OK;}</attr>
