    <Node id="Decode0" type="REFORMAT" enabled="enabled" guiName="Decode0" guiX="275" guiY="200">
      <attr name="transform">//#CTL2
function integer transform(){
$out.0.machine_key=$in.0.machine_key;
$out.0.machine_tenant=$in.0.machine_tenant;
$out.0.machine_file=$in.0.machine_file;
$out.0.machine_row=$in.0.machine_row == null ? null : str2long($in.0.machine_row);
$out.0.machine_received=$in.0.machine_received == null ? null : str2date($in.0.machine_received,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
$out.0.machine_team=$in.0.machine_team;
$out.0.machine_market=$in.0.machine_market;
$out.0.machine_currency=$in.0.machine_currency;
$out.0.machine_batch=$in.0.machine_batch;
$out.0.machine_note=$in.0.machine_note;
$out.0.machine_trace=$in.0.machine_trace;
$out.0.machine_unused_archive=$in.0.machine_unused_archive;
$out.0.channels_json=$in.0.channels_json;
$out.0.rated_capacity=$in.0.rated_capacity == null ? null : str2decimal($in.0.rated_capacity);
$out.0.commissioned_on=$in.0.commissioned_on == null ? null : str2date($in.0.commissioned_on,"yyyy-MM-dd HH:mm:ss.SSS","en.US","UTC",true);
return OK;}</attr>
    </Node>
    <Edge id="Read0" fromNode="Reader0:0" toNode="Decode0:0" metadata="RawIn0" guiRouter="Manhattan" inPort="Port 0 (in)" outPort="Port 0 (out)" />
