      <attr name="charset">UTF-8</attr>
      <attr name="transform">//#CTL2
function integer transform() {
 boolean exists=!isnull($in.0.previous_sk);
 boolean changed=$in.0.risk_class != $in.0.previous_risk_class || $in.0.contract_value != $in.0.previous_value;
 if (exists &amp;&amp; !changed) return SKIP;
 $out.1.*=$in.0.*;
 $out.1.version_sk=sequence(DimKeys,long).next();
 $out.1.valid_from=$in.0.event_at;$out.1.valid_to=null;$out.1.is_current=true;
 if (!exists) return 1;
 $out.0.*=$in.0.*;
 $out.0.version_sk=$in.0.previous_sk;$out.0.valid_from=$in.0.previous_from;
 $out.0.valid_to=$in.0.event_at;$out.0.is_current=false;
 $out.0.risk_class=$in.0.previous_risk_class;$out.0.contract_value=$in.0.previous_value;
 return ALL;
}
</attr>
