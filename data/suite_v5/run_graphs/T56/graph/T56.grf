      <attr name="charset">UTF-8</attr>
      <attr name="denormalize">//#CTL2
string w_supplier_ref_no;
string w_tenant_cd;
string w_source_file_nm;
date w_received_at;
long w_source_row_no;
string w_owner_team_cd;
string w_market_cd;
string w_currency_cd;
string w_batch_ref;
string w_operator_note;
string w_external_trace_id;
string w_unused_archive_label;
string w_legal_nm;
string w_tax_country;
string w_payment_iban;
date w_revision_at;
long w_revision_no;
decimal w_estimated_value;
boolean have=false;
boolean good=false;
integer seen=0;
function integer append() {
 boolean complete=!isnull($in.0.legal_nm) &amp;&amp; trim($in.0.legal_nm) != "" &amp;&amp; !isnull($in.0.tax_country) &amp;&amp; trim($in.0.tax_country) != "" &amp;&amp; !isnull($in.0.payment_iban) &amp;&amp; trim($in.0.payment_iban) != "";
 boolean better=!have;
 if (have) {
  if (complete &amp;&amp; !good) better=true;
  else if (complete == good) {
   if (!isnull($in.0.revision_at) &amp;&amp; isnull(w_revision_at)) better=true;
   else if (!isnull($in.0.revision_at) &amp;&amp; !isnull(w_revision_at) &amp;&amp; $in.0.revision_at &gt; w_revision_at) better=true;
   else if ($in.0.revision_at == w_revision_at &amp;&amp; $in.0.revision_no &gt; w_revision_no) better=true;
  }
 }
 if (better) {w_supplier_ref_no=$in.0.supplier_ref_no;w_tenant_cd=$in.0.tenant_cd;w_source_file_nm=$in.0.source_file_nm;w_received_at=$in.0.received_at;w_source_row_no=$in.0.source_row_no;w_owner_team_cd=$in.0.owner_team_cd;w_market_cd=$in.0.market_cd;w_currency_cd=$in.0.currency_cd;w_batch_ref=$in.0.batch_ref;w_operator_note=$in.0.operator_note;w_external_trace_id=$in.0.external_trace_id;w_unused_archive_label=$in.0.unused_archive_label;w_legal_nm=$in.0.legal_nm;w_tax_country=$in.0.tax_country;w_payment_iban=$in.0.payment_iban;w_revision_at=$in.0.revision_at;w_revision_no=$in.0.revision_no;w_estimated_value=$in.0.estimated_value;good=complete;have=true;}
 seen++;
 return OK;
}
function integer transform() {$out.0.supplier_ref_no=w_supplier_ref_no;$out.0.tenant_cd=w_tenant_cd;$out.0.source_file_nm=w_source_file_nm;$out.0.received_at=w_received_at;$out.0.source_row_no=w_source_row_no;$out.0.owner_team_cd=w_owner_team_cd;$out.0.market_cd=w_market_cd;$out.0.currency_cd=w_currency_cd;$out.0.batch_ref=w_batch_ref;$out.0.operator_note=w_operator_note;$out.0.external_trace_id=w_external_trace_id;$out.0.unused_archive_label=w_unused_archive_label;$out.0.legal_nm=w_legal_nm;$out.0.tax_country=w_tax_country;$out.0.payment_iban=w_payment_iban;$out.0.revision_at=w_revision_at;$out.0.revision_no=w_revision_no;$out.0.estimated_value=w_estimated_value;$out.0.winner_complete=good;$out.0.versions_seen=seen;return OK;}
function void clean() {have=false;good=false;seen=0;}
</attr>
