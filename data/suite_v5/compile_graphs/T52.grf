    <LookupTable id="ServiceRules" name="ServiceRules" type="simpleLookup" metadata="RuleMeta" key="brand_cd;warranty_tier" initialSize="16" />
  </Global>
  <Phase number="0">
    <Node id="Source0" type="DATA_GENERATOR" recordsNumber="0">
      <attr name="generate">//#CTL2
function integer generate(){return OK;}</attr>
    </Node>
    <Node id="UnderTest" type="REFORMAT">
      <attr name="transform">//#CTL2
function integer transform() {
 $out.0.*=$in.0.*;
 string a=upperCase(trim(nvl($in.0.brand_cd,"")));
 string b=upperCase(trim(nvl($in.0.warranty_tier,"")));
 $out.0.reference_key=a+":"+b;
 $out.0.response_hours=48;
 $out.0.reference_miss=true;
 if (a != "" &amp;&amp; b != "") {
  Rules ref=lookup(ServiceRules).get(a,b);
  if (ref != null) {$out.0.reference_miss=false;$out.0.response_hours=nvl(ref.response_hours,48);}
 }
 return OK;
}
</attr>
    </Node>
    <Edge id="Input0" fromNode="Source0:0" toNode="UnderTest:0" metadata="In0" />
    <Node id="Sink0" type="TRASH" />
    <Edge id="Output0" fromNode="UnderTest:0" toNode="Sink0:0" metadata="Out0" />
