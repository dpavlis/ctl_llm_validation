    <Sequence id="AuditRows" name="AuditRows" type="SIMPLE_SEQUENCE" start="1" step="1" />
  </Global>
  <Phase number="0">
    <Node id="Source0" type="DATA_GENERATOR" recordsNumber="0">
      <attr name="generate">//#CTL2
function integer generate(){return OK;}</attr>
    </Node>
    <Node id="UnderTest" type="REFORMAT">
      <attr name="transform">//#CTL2
function string frame(string value) {return num2str(length(value))+":"+value;}
function string marked(string value) {return isnull(value) ? "N" : "V"+value;}
function integer transform() {
 $out.0.*=$in.0.*;
 $out.0.run_id=getParamValue("RUN_ID");
 $out.0.run_ts=str2date(getParamValue("RUN_TS"),"yyyy-MM-dd HH:mm:ss","en.US","UTC",true);
 $out.0.audit_source=getParamValue("SOURCE_FILE");
 string a=marked($in.0.merchant_cd);string b=marked($in.0.transaction_ref);
 string c=isnull($in.0.posted_amount) ? "N" : "V"+num2str(round($in.0.posted_amount,2),"0.00","en.US");
 string d=isnull($in.0.posting_dt) ? "N" : "V"+date2str($in.0.posting_dt,"yyyy-MM-dd HH:mm:ss","en.US","UTC");
 $out.0.record_digest=lowerCase(sha256HexString(frame(a)+frame(b)+frame(c)+frame(d)));
 $out.0.audit_seq=sequence(AuditRows,long).next();
 return OK;
}
</attr>
    </Node>
    <Edge id="Input0" fromNode="Source0:0" toNode="UnderTest:0" metadata="In0" />
    <Node id="Sink0" type="TRASH" />
    <Edge id="Output0" fromNode="UnderTest:0" toNode="Sink0:0" metadata="Out0" />
  </Phase>
</Graph>