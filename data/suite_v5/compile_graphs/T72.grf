      </Record>
    </Metadata>
    <Metadata id="Out0">
      <Record name="Audited" type="delimited" fieldDelimiter="|" recordDelimiter="\n">
        <Field name="receipt_ref_no" type="string" nullable="false" />
        <Field name="tenant_cd" type="string" nullable="false" />
        <Field name="source_file_nm" type="string" nullable="false" />
        <Field name="received_at" type="date" nullable="false" format="yyyy-MM-dd HH:mm:ss" />
